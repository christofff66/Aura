name: Nw

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
          cache: gradle

      - name: Find V31 package
        shell: bash
        run: |
          set -e

          ZIP=$(find . -type f -iname '*V31*.zip' | head -n 1)

          if [ -z "$ZIP" ]; then
            echo "ERROR: Aucun ZIP V31 trouvé."
            find . -maxdepth 3 -type f | sort
            exit 1
          fi

          echo "V31 package trouvé : $ZIP"
          echo "AURA_V31_ZIP=$ZIP" >> "$GITHUB_ENV"

      - name: Extract V31 package
        shell: bash
        run: |
          set -e

          rm -rf build/aura-v31
          mkdir -p build/aura-v31

          unzip -q "$AURA_V31_ZIP" -d build/aura-v31

          echo "Contenu extrait :"
          find build/aura-v31 -maxdepth 3 -type f | sort | head -300

      - name: Locate Android project
        shell: bash
        run: |
          set -e

          PROJECT_DIR=$(find build/aura-v31 \
            -type f \( \
              -name "settings.gradle" \
              -o -name "settings.gradle.kts" \
            \) \
            -print -quit | xargs -r dirname)

          if [ -z "$PROJECT_DIR" ]; then
            echo "ERROR: Projet Android Gradle introuvable."
            exit 1
          fi

          echo "Projet Android : $PROJECT_DIR"
          echo "AURA_PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"

      - name: Configure Gradle
        shell: bash
        run: |
          set -e

          cd "$AURA_PROJECT_DIR"

          touch gradle.properties

          grep -q '^org.gradle.jvmargs=' gradle.properties \
            || echo 'org.gradle.jvmargs=-Xmx4g -Dfile.encoding=UTF-8' >> gradle.properties

          grep -q '^android.useAndroidX=' gradle.properties \
            || echo 'android.useAndroidX=true' >> gradle.properties

          grep -q '^android.enableJetifier=' gradle.properties \
            || echo 'android.enableJetifier=true' >> gradle.properties

          grep -q '^kotlin.code.style=' gradle.properties \
            || echo 'kotlin.code.style=official' >> gradle.properties

      - name: Prepare Gradle wrapper
        shell: bash
        run: |
          set -e

          cd "$AURA_PROJECT_DIR"

          if [ ! -f "./gradlew" ]; then
            echo "gradlew absent : génération du wrapper."

            if command -v gradle >/dev/null 2>&1; then
              gradle wrapper --gradle-version 8.10
            else
              curl -fsSL \
                https://services.gradle.org/distributions/gradle-8.10-bin.zip \
                -o /tmp/gradle.zip

              unzip -q /tmp/gradle.zip -d /tmp/gradle

              /tmp/gradle/gradle-8.10/bin/gradle \
                wrapper \
                --gradle-version 8.10
            fi
          fi

          chmod +x ./gradlew

      - name: Show Gradle information
        shell: bash
        run: |
          cd "$AURA_PROJECT_DIR"
          ./gradlew --version

      - name: Build Aura V31 Debug APK
        shell: bash
        run: |
          set -e

          cd "$AURA_PROJECT_DIR"

          ./gradlew clean assembleDebug \
            --stacktrace \
            --no-daemon

      - name: Find APK
        shell: bash
        run: |
          set -e

          APK=$(find "$AURA_PROJECT_DIR" \
            -type f \
            -name "*.apk" \
            | head -n 1)

          if [ -z "$APK" ]; then
            echo "ERROR: Aucun APK généré."
            exit 1
          fi

          echo "APK généré : $APK"
          echo "AURA_APK=$APK" >> "$GITHUB_ENV"

      - name: Copy APK
        shell: bash
        run: |
          mkdir -p build/final

          cp "$AURA_APK" \
            "build/final/Aura-V31-debug.apk"

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: Aura-V31-APK
          path: build/final/Aura-V31-debug.apk
          if-no-files-found: error
